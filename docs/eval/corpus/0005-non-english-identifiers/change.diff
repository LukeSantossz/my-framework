+package pedido
+
+// Pedido representa um pedido do cliente.
+type Pedido struct {
+	Codigo     string
+	Quantidade int
+}
+
+// CalcularTotal soma o valor dos itens.
+func CalcularTotal(itens []Pedido) int {
+	total := 0
+	for _, item := range itens {
+		total += item.Quantidade
+	}
+	return total
+}
