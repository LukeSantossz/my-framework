-	return out
+// Renderer holds the formatting options.
+type Renderer struct {
+	Separator string
+	Indent    int
+}
+
+func New() *Renderer { return &Renderer{Separator: ": "} }
+
+func (r *Renderer) Render(entries []Entry) string {
+	var b strings.Builder
+	for _, e := range entries {
+		b.WriteString(strings.Repeat(" ", r.Indent))
+		b.WriteString(e.Key + r.Separator + e.Value + "\n")
+	}
+	return b.String()
 }
